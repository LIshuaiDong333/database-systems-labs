    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_GENERATE
    BUTTON      ID_PARSE
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建(&N)...\tCtrl+N",         ID_FILE_NEW
        MENUITEM "打开(&O)...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "添加工程...",                 ID_ADD_PROJECT
        MENUITEM "全部保存",                    ID_SAVE_ALL
        MENUITEM "关闭工程",                    ID_CLOSE_PROJECT
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                    ID_APP_EXIT
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "工程",                        ID_PROJECT_TREE
        MENUITEM "输出",                        ID_MESSAGE
        MENUITEM SEPARATOR
        MENUITEM "向导",                        ID_WIZARD
        MENUITEM "导航栏",                      ID_NAVIGATOR
    END
    POPUP "生成"
    BEGIN
        MENUITEM "生成分析表...",               ID_GENERATE
        MENUITEM "动态分析...",                 ID_PARSE
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "帮助",                        ID_HELP
        MENUITEM "关于编译工作台(&A)...",       ID_APP_ABOUT
    END
END

IDR_GRMTYPE MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建(&N)...\tCtrl+N",         ID_FILE_NEW
        MENUITEM "打开(&O)...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM "保存(&S)\tCtrl+S",            ID_FILE_SAVE
        MENUITEM "另存为(&A)...",               ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "添加工程...",                 ID_ADD_PROJECT
        MENUITEM "全部保存",                    ID_SAVE_ALL
        MENUITEM "关闭工程",                    ID_CLOSE_PROJECT
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                    ID_APP_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "撤消(&U)\tCtrl+Z",            ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)\tCtrl+X",            ID_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",            ID_EDIT_COPY
        MENUITEM "粘贴(&P)\tCtrl+V",            ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "查找(&F)...\tCtrl+F",         ID_EDIT_FIND
        MENUITEM "替换(&E)...\tCtrl+H",         ID_EDIT_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "全选(&A)\tCtrl+A",            ID_EDIT_SELECT_ALL
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "工程",                        ID_PROJECT_TREE
        MENUITEM "输出",                        ID_MESSAGE
        MENUITEM SEPARATOR
        MENUITEM "向导",                        ID_WIZARD
        MENUITEM "导航栏",                      ID_NAVIGATOR
    END
    POPUP "生成"
    BEGIN
        MENUITEM "生成分析表...",               ID_GENERATE
        MENUITEM "动态分析...",                 ID_PARSE
    END
    POPUP "窗口(&W)"
    BEGIN
        MENUITEM "新建窗口(&N)",                ID_WINDOW_NEW
        MENUITEM "层叠(&C)",                    ID_WINDOW_CASCADE
        MENUITEM "平铺(&T)",                    ID_WINDOW_TILE_HORZ
        MENUITEM "排列图标(&A)",                ID_WINDOW_ARRANGE
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "帮助",                        ID_HELP
        MENUITEM "关于编译工作台(&A)...",       ID_APP_ABOUT
    END
END

