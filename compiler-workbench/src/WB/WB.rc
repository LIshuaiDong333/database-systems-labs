IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 228, 130
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于编译工作台"
FONT 9, "宋体"
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,160,110,50,14,WS_GROUP
    LTEXT           "2005年北京邮电大学",IDC_STATIC,10,10,73,8
    LTEXT           "本科生毕业设计",IDC_STATIC,17,20,57,8
    LTEXT           "编译工作台",IDC_STATIC1,49,40,130,20
    LTEXT           "作者：尹涛",IDC_STATIC,144,75,41,8
    LTEXT           "导师：杨正球",IDC_STATIC,140,90,49,8
END

IDD_NEWPROJECT_DIALOG DIALOGEX 0, 0, 242, 135
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "新建工程"
FONT 12, "Fixedsys", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_EDIT,20,30,200,15,ES_MULTILINE | ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_DIRECTORY,205,78,20,15
    DEFPUSHBUTTON   "确定",IDOK,95,110,60,14
    PUSHBUTTON      "取消",IDCANCEL,165,110,60,14
    LTEXT           "工程名",IDC_STATIC,20,10,35,10
    LTEXT           "工程目录",IDC_STATIC,20,56,40,10
    LTEXT           "",IDC_INFO,20,76,175,19,0,WS_EX_STATICEDGE
END

IDD_NEW_DIALOG DIALOGEX 0, 0, 242, 200
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "新建"
FONT 12, "Fixedsys", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_EDIT,20,105,205,15,ES_MULTILINE | ES_AUTOHSCROLL
    CONTROL         "List1",IDC_LIST,"SysListView32",LVS_SINGLESEL | 
                    LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,20,10,205,40
    PUSHBUTTON      "...",IDC_DIRECTORY_BUTTON,205,147,20,15
    DEFPUSHBUTTON   "确定",IDOK,105,175,55,15
    PUSHBUTTON      "取消",IDCANCEL,170,175,55,15
    LTEXT           "描述",IDC_STATIC,20,55,20,10
    LTEXT           "",IDC_INFO,20,70,205,15,0,WS_EX_STATICEDGE
    LTEXT           "文件名",IDC_STATIC,20,90,25,10
    LTEXT           "文件目录",IDC_STATIC,20,130,35,10
    LTEXT           "",IDC_DIRECTORY,20,145,175,20,0,WS_EX_STATICEDGE
END

IDD_SELECT_DIALOG DIALOG DISCARDABLE  0, 0, 224, 125
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "动态演示"
FONT 12, "Fixedsys"
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,94,105,55,15
    PUSHBUTTON      "取消",IDCANCEL,159,105,55,15
    LTEXT           "选择文法",IDC_STATIC,9,5,35,10
    LTEXT           "选择源文件",IDC_STATIC,114,5,40,10
    LISTBOX         IDC_GRAMMAR_LIST,9,20,100,75,LBS_NOINTEGRALHEIGHT | 
                    LBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
    LISTBOX         IDC_SOURCE_LIST,114,20,101,75,LBS_NOINTEGRALHEIGHT | 
                    LBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
END

IDD_GENERATE_DIALOG DIALOG DISCARDABLE  0, 0, 234, 141
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "生成分析表"
FONT 12, "Fixedsys"
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,100,122,60,15
    PUSHBUTTON      "取消",IDCANCEL,170,122,60,15
    CONTROL         "生成LL1分析表",IDC_CHECK1,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,145,22,65,15
    CONTROL         "生成LR0分析表",IDC_CHECK2,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,20,48,65,15
    CONTROL         "生成SLR分析表",IDC_CHECK3,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,145,48,65,15
    CONTROL         "生成LR1分析表",IDC_CHECK4,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,20,72,65,15
    CONTROL         "生成LALR分析表",IDC_CHECK5,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,145,72,70,15
    CONTROL         "生成FIRST/FOLLOW集合",IDC_CHECK6,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,20,22,95,15
    GROUPBOX        "分析表选择",IDC_STATIC,5,10,225,85
    CONTROL         "全部选择/取消",IDC_CHECK7,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,20,103,68,10
END

IDD_WIZARD_DIALOG DIALOG DISCARDABLE  0, 0, 193, 136
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "向导"
FONT 12, "Fixedsys"
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,68,114,50,14
    PUSHBUTTON      "取消",IDCANCEL,127,114,50,14
